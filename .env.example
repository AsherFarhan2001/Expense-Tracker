# Copy to .env.local and fill in. Never commit real values.

# Neon connection string: the "dev" branch locally, the "main" branch on Vercel.
# Leave empty to use a local PGlite database in .data/pglite (zero setup).
DATABASE_URL=

# Optional override: "neon" or "pglite". Default: neon if DATABASE_URL is set, else pglite.
DATABASE_DRIVER=

# PGlite data directory (pglite driver only).
PGLITE_DIR=.data/pglite

# Exchange rates: "live" (default, free daily API) or "fixed" (uses FX_FIXED_PKR_PER_QAR; for tests/offline).
FX_PROVIDER=
FX_FIXED_PKR_PER_QAR=76.5

# PIN lock for the live site. Leave APP_PIN_HASH empty locally to disable the lock.
# Generate with: npm run pin:hash -- <your-pin>
APP_PIN_HASH=
SESSION_SECRET=
