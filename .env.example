# Copy to .env.local and fill in. Never commit real values.

# Neon connection string: the "dev" branch locally, the "main" branch on Vercel.
DATABASE_URL=

# "neon" (default) or "pglite" (in-process Postgres for tests / offline dev).
DATABASE_DRIVER=neon

# PGlite data directory, used only when DATABASE_DRIVER=pglite.
PGLITE_DIR=.data/pglite

# PIN lock for the live site. Leave APP_PIN_HASH empty locally to disable the lock.
APP_PIN_HASH=
SESSION_SECRET=
